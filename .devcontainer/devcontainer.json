{
  "name": "Portfolio BUT SD",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Site du portfolio", "onAutoForward": "openPreview" }
  },
  "postCreateCommand": "bash .devcontainer/demarrage.sh",
  "postStartCommand": "bash .devcontainer/lancer-bdd.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ckolkman.vscode-postgres"]
    }
  }
}
